# Copy this file to .env and fill in real values. Never commit .env.

# ============================================================
# Docker Compose deployment (only needed if you're standing up
# your own instance with `docker compose up -d`)
# ============================================================

# --- MariaDB ---
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=moodle
MYSQL_USER=moodle_user
MYSQL_PASSWORD=change_me_db_password

# --- Moodle admin account ---
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=change_me_admin_password
MOODLE_SITE_NAME="My Moodle Site"

# Full public URL (REQUIRED, see README section 4).
# Example: https://moodle.example.com  or  https://example.com:40599
MOODLE_HOST=https://your-public-domain.example.com

# Host port mapped to the container's port 80 (Apache inside always listens on 80).
MOODLE_HOST_PORT=2229

# ============================================================
# MCP client config (only needed if you're querying an
# already-running instance, e.g. with curl or a script —
# doesn't require the Docker Compose section above)
# ============================================================

MOODLE_MCP_ENDPOINT=https://your-public-domain.example.com/webservice/mcp/server.php
MOODLE_MCP_TOKEN=your_mcp_token_here

# Optional: extra role-scoped tokens, if you set up more than one
# (see README section 7 "Modelo de permissões: serviço vs. token").
# MOODLE_MCP_TOKEN_MANAGER=
# MOODLE_MCP_TOKEN_COURSECREATOR=
# MOODLE_MCP_TOKEN_TEACHER=
# MOODLE_MCP_TOKEN_STUDENT=
